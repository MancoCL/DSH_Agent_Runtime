{
  "name": "dsh-gac-runtime",
  "version": "0.1.1",
  "description": "DeepSeek Harness 的 GAC（Governed Agent Collaboration）运行时：风险分级、严格写范围、独立验证与证据",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "governed-agent-collaboration",
    "agent-runtime"
  ],
  "homepage": "https://github.com/MancoCL/DSH_Agent_Runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MancoCL/DSH_Agent_Runtime.git"
  },
  "bugs": {
    "url": "https://github.com/MancoCL/DSH_Agent_Runtime/issues"
  },
  "author": "MancoCL",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./write-scope": "./lib/write-scope.js",
    "./project": "./lib/project.js",
    "./coordinator": "./lib/coordinator.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "examples",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "plugin:status": "node scripts/plugin-switch.js status",
    "plugin:on": "node scripts/plugin-switch.js on",
    "plugin:off": "node scripts/plugin-switch.js off",
    "deploy:status": "node scripts/plugin-deploy.js status",
    "deploy:validate": "node scripts/plugin-deploy.js validate",
    "deploy:publish": "node scripts/plugin-deploy.js publish",
    "deploy:restore": "node scripts/plugin-deploy.js restore",
    "profile:status": "node scripts/profile-switch.js status",
    "profile:use": "node scripts/profile-switch.js use",
    "profile:restore": "node scripts/profile-switch.js restore"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
