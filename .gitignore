# 依赖、日志和生成物
node_modules/
*.log
coverage/
dist/
tmp/
temp/
.cache/
*.tgz

# 本机工程适配器、任务、证据、会话和验收状态均不属于插件源码
# 公开的可复用适配器示例只放在 examples/，不要对 .dsh/ 做例外放行
.dsh/

# 一次性 ACL 修复与文件备份（本机专属）
.acl-recovery/
*.bak
*.bak-*
*.repairing-*

# 环境变量、认证凭据和私钥
.env
.env.*
!.env.example
.npmrc
.pypirc
*.pem
*.key
id_rsa
id_ed25519
**/credentials.json
**/service-account*.json

# 操作系统噪音
Thumbs.db
.DS_Store

# 每任务唯一的临时提交信息（永不提交）
.commitmsg
.commitmsg-*
