# Dependencies and logs
node_modules/
*.log

# ACL recovery artefacts from the one-shot sandbox repair (not part of the plugin)
.acl-recovery/

# Per-project adapters are project data, not plugin source
.dsh/gac/local/

# Runtime write-claims are transient coordination state
.dsh/gac/claims/

# Task records are runtime state, not plugin source
.dsh/gac/tasks/

# Frozen verification plans are runtime state too
.dsh/gac/plans/

# Interview records and frozen interface contracts are runtime state
.dsh/gac/grilling/
.dsh/gac/contracts/

# OS noise
Thumbs.db
.DS_Store

# scratch commit-message files (one per task, never committed)
.commitmsg
.commitmsg-*
