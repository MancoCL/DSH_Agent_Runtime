# 依赖与日志
node_modules/
*.log

# 一次性沙箱修复留下的 ACL 恢复产物（不属于插件）
.acl-recovery/

# 每工程的适配器是工程数据，不是插件源码
.dsh/gac/local/

# 运行时的写占用是临时协调状态
.dsh/gac/claims/

# 任务记录是运行时状态，不是插件源码
.dsh/gac/tasks/

# 已冻结的验证计划同样是运行时状态
.dsh/gac/plans/

# 访谈记录与已冻结的接口契约是运行时状态
.dsh/gac/grilling/
.dsh/gac/contracts/

# 只追加的证据日志是运行时状态
.dsh/gac/evidence/

# 操作系统噪音文件
Thumbs.db
.DS_Store

# 提交信息临时文件（每任务一个，永不提交）
.commitmsg
.commitmsg-*
