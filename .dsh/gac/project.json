{
  "schema_version": 1,
  "project": {
    "id": "dsh-gac-runtime",
    "title": "DeepSeek Harness 的 GAC 运行时插件"
  },
  "capabilities": [
    "implementation",
    "verification",
    "review",
    "documentation"
  ],
  "executors": {
    "implementation": ["builder"],
    "verification": ["verifier"],
    "review": ["reviewer"],
    "documentation": ["builder"]
  },
  "execution": {
    "require_contract": ["high_risk_task"],
    "provider_routes": {},
    "native_child_dispatch": true,
    "required_capabilities": [
      "native_child_dispatch",
      "workspace_observation",
      "role_isolation",
      "write_claims",
      "evidence_log",
      "semantic_artifacts"
    ]
  },
  "risk": {
    "high_risk_paths": [
      "lib/write-scope.js",
      "lib/plugin.js",
      "lib/tool-targets.js",
      "lib/session-scope.js",
      "lib/resolve-dsh.js"
    ],
    "default_level": "low"
  },
  "memory": {
    "allow": ["current_project", "global_reusable"],
    "deny_as_project_fact": ["foreign_project", "unknown"]
  },
  "authority": {
    "enforcement_mode": "tool_guard"
  },
  "checkpoint": {
    "provider": "git",
    "policy": "required_per_task",
    "message_format": {
      "subject": "type(scope): 中文简述",
      "body": "空行后写功能段落：改了什么行为、为什么、影响哪些场景；不逐文件罗列",
      "layout": "段落内不折行；段间恰好一个空行；末尾不加署名行",
      "language": "zh-CN"
    },
    "commit_scope": "只提交本任务负责的路径（git add <path>...）；禁止 git add . / git add -A；永不 push、永不 amend；提交信息的临时文件用本任务唯一的绝对路径，并在提交成功的那条命令里删除",
    "convention": "AGENTS.md",
    "note": "口径来自同机 00_GAC_Project 的 .claude 提交约定，格式全文与复核方法见 AGENTS.md。此处只作声明：运行时尚无代码消费 checkpoint（lib/ 只在适配器校验时放行该键，不读取内容），因此它不是机器强制。"
  }
}
